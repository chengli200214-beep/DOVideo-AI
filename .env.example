SERVER_PORT=9090
SERVER_ADDRESS=127.0.0.1
DB_USERNAME=dovideo
# Fresh Compose installs create this account; keep it equal to DB_USERNAME.
MYSQL_APP_USER=dovideo
DB_PASSWORD=change-me
DB_URL='jdbc:mysql://localhost:3307/media_db?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=utf-8&allowPublicKeyRetrieval=true'
MYSQL_ROOT_PASSWORD=change-root-password
FLYWAY_BASELINE_ON_MIGRATE=true
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_TIMEOUT_SECONDS=300
LLM_INPUT_PRICE_PER_MILLION=0
LLM_OUTPUT_PRICE_PER_MILLION=0
AGENT_MAX_ESTIMATED_COST=0
AGENT_MAX_ROUNDS=2
AGENT_MAX_DURATION_MS=120000
AGENT_MAX_ESTIMATED_TOKENS=50000
AGENT_EVALUATION_ENABLED=false
AI_INTERACTIVE_TIMEOUT_MS=180000
EMBEDDING_MODEL=BAAI/bge-m3
ASR_MODEL=TeleAI/TeleSpeechASR
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MINIO_ACCESS_KEY=dovideo
MINIO_SECRET_KEY=change-me-now
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=media
QDRANT_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=change-me-qdrant
QDRANT_COLLECTION=video_chunks
YTDLP_PATH=yt-dlp
# 部分站点（如 B 站）缺少登录态会返回 HTTP 412，需要提供 cookie 才能下载在线视频链接。
# 二者互斥，YTDLP_COOKIES 优先；留空则不带 cookie（仅支持无需登录的站点）。
YTDLP_COOKIES=
YTDLP_COOKIES_FROM_BROWSER=
FFMPEG_DIR=
# CJK font path; defaults to Microsoft YaHei on Windows or Noto Sans CJK on Linux.
COMPOSITION_FONT_PATH=
OCR_COMMAND=tesseract
ROCKETMQ_NAME_SERVER=127.0.0.1:9876
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:9090
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Video generation stays in mock mode until paid invocation is explicitly authorized.
GENERATION_PROVIDER=mock
# Seedance Mini uses a separate Ark key; no paid invocation is enabled by configuring credentials.
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_ARTIFACT_HOSTS=
SEEDANCE_RECOVERY_ENABLED=false
GENERATION_PAID_ENABLED=false
# Query/archive original video tasks only; never authorizes a new generation.
GENERATION_RECOVERY_ENABLED=false
GENERATION_API_KEY=
GENERATION_BASE_URL=https://api.siliconflow.cn/v1
GENERATION_TEXT_MODEL=Wan-AI/Wan2.2-T2V-A14B
GENERATION_IMAGE_MODEL=Wan-AI/Wan2.2-I2V-A14B
GENERATION_ARTIFACT_HOSTS=
GENERATION_WORKER_DELAY_MS=2000
GENERATION_AUTHORIZATION_ID=
GENERATION_APPROVED_MODELS=
GENERATION_MAX_PAID_TASKS=0
# CNY reservation, not supplier settlement. Set a verified conservative per-call amount before enabling.
GENERATION_BUDGET_LIMIT=0
GENERATION_RESERVATION_PER_TASK=0
GENERATION_TEXT_ENABLED=true
GENERATION_TEXT_SIZES=1280x720,720x1280,960x960
GENERATION_TEXT_NEGATIVE_PROMPT=true
GENERATION_TEXT_SEED=true
GENERATION_TEXT_MAX_PROMPT_LENGTH=2000
GENERATION_IMAGE_ENABLED=true
GENERATION_IMAGE_SIZES=1280x720,720x1280,960x960
GENERATION_IMAGE_NEGATIVE_PROMPT=true
GENERATION_IMAGE_SEED=true
GENERATION_IMAGE_MAX_PROMPT_LENGTH=2000

# DeepSeek script/storyboard: separate opt-in, default off. This is NOT a Codex/ChatGPT subscription.
# Direct DeepSeek uses deepseek-flash; SiliconFlow uses its own exact DeepSeek model ID and key.
STORYBOARD_PAID_ENABLED=false
STORYBOARD_API_KEY=
STORYBOARD_BASE_URL=https://api.deepseek.com
STORYBOARD_MODEL=deepseek-flash
STORYBOARD_AUTHORIZATION_ID=
STORYBOARD_APPROVED_MODEL=
STORYBOARD_CURRENCY=CNY
STORYBOARD_MAX_CALLS=0
STORYBOARD_BUDGET_LIMIT=0
STORYBOARD_RESERVATION_PER_CALL=0
# Verified provider prices in the selected currency per million tokens; zero prevents activation.
STORYBOARD_INPUT_PRICE_PER_MILLION=0
STORYBOARD_OUTPUT_PRICE_PER_MILLION=0
STORYBOARD_MAX_TOKENS=4096
STORYBOARD_TIMEOUT_SECONDS=60
